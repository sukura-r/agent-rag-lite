# 复制到受权限保护的部署环境变量文件中；不要把真实值提交到Git。
SPRING_PROFILES_ACTIVE=prod
MYSQL_URL=jdbc:mysql://mysql-host:3306/agent_rag?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
MYSQL_USERNAME=agent_rag_app
MYSQL_PASSWORD=replace-with-secret-manager-value
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-redis-password
MILVUS_URI=http://milvus-host:19530
DOCUMENT_STORAGE_ENDPOINT=http://object-storage-host:9000
DOCUMENT_STORAGE_ACCESS_KEY=replace-with-object-storage-access-key
DOCUMENT_STORAGE_SECRET_KEY=replace-with-object-storage-secret-key
DOCUMENT_STORAGE_BUCKET=knowledge-source
DOCUMENT_MAX_FILE_SIZE=20MB
DOCUMENT_MAX_REQUEST_SIZE=21MB
DOCUMENT_MAX_FILE_BYTES=20971520
DOCUMENT_MAX_CHARACTERS=200000
DOCUMENT_MAX_CHUNKS=1000
DOCUMENT_MAX_PDF_PAGES=300
DOCUMENT_PARSE_TIMEOUT_SECONDS=60
DOCUMENT_PARSE_CONCURRENCY=2
DOCUMENT_PARSE_MAX_ATTEMPTS=3
DOCUMENT_PARSE_POLL_DELAY_MS=1000
DOCUMENT_PARSE_LEASE_SECONDS=120
DOCUMENT_PARSER_VERSION=tika-3.3.2-markdown-v1
ROCKETMQ_NAMESERVER=rocketmq-nameserver:9876
MODEL_BASE_URL=http://model-service:11434/v1
MODEL_API_KEY=replace-with-model-service-key
CHAT_MODEL=qwen3:4b-instruct
MODEL_REASONING_EFFORT=none
MODEL_MAX_OUTPUT_TOKENS=512
APP_USER_TOKEN=replace-with-login-service-issued-token
APP_ADMIN_TOKEN=replace-with-admin-token
MCP_INTERNAL_TOKEN=replace-with-service-to-service-token
