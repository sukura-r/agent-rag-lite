# Copy to .env for a LOCAL demo. Do not commit real credentials.
# Both Docker Compose and deploy/local.ps1 or deploy/local.sh read this file.
# Values use simple KEY=value syntax; do not add shell commands or variable expansion.
SERVER_PORT=8080
MYSQL_PORT=23306
MYSQL_URL="jdbc:mysql://127.0.0.1:23306/agent_rag?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false"
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
REDIS_HOST=127.0.0.1
REDIS_PORT=26379
REDIS_PASSWORD=
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge_chunks_qwen3_1024_v1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DOCUMENT_STORAGE_ENDPOINT=http://127.0.0.1:9000
DOCUMENT_STORAGE_ACCESS_KEY=minioadmin
DOCUMENT_STORAGE_SECRET_KEY=minioadmin
DOCUMENT_STORAGE_BUCKET=knowledge-source
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_NAMESERVER=127.0.0.1:9876
BROKER_ADVERTISED_HOST=127.0.0.1
BROKER_PORT=10911
HOST_BIND_IP=127.0.0.1
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_API_KEY=ollama
CHAT_MODEL=qwen3:4b-instruct
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024
MODEL_TIMEOUT_SECONDS=300
MODEL_MAX_ATTEMPTS=2
MODEL_RETRY_BACKOFF_MS=300
MCP_SERVER_URL=http://127.0.0.1:8080/mcp
APP_USER_TOKEN=local-user-token
APP_ADMIN_TOKEN=local-admin-token
MCP_INTERNAL_TOKEN=local-mcp-token
AGENT_MAX_CONCURRENT_TASKS=4
AGENT_HISTORY_LIMIT=10
AGENT_STREAM_TIMEOUT_MS=600000
MEMORY_AUTO_CAPTURE_ENABLED=true
MEMORY_LLM_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_TIMEOUT_MS=5000
MEMORY_MAX_RECALL_CANDIDATES=200
