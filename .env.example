# 默认值已经匹配本机Ollama，只有替换供应商或模型时才需要设置这些变量。
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
CHAT_MODEL=qwen3:4b-instruct
EMBEDDING_DIMENSION=1024
MILVUS_COLLECTION=knowledge_chunks_qwen3_1024_v1
MODEL_TIMEOUT_SECONDS=300
MODEL_MAX_ATTEMPTS=2
MODEL_RETRY_BACKOFF_MS=300
REDIS_HOST=127.0.0.1
REDIS_PORT=26379
# 本地开发专用实例只绑定127.0.0.1，无需密码；生产环境必须配置认证和网络隔离。
REDIS_PASSWORD=
REDIS_TIMEOUT=2s
AGENT_HISTORY_LIMIT=10
AGENT_STREAM_TIMEOUT_MS=600000
ROCKETMQ_NAMESERVER=127.0.0.1:9876

# Ollama本地接口不校验API Key；ollama只是非敏感占位值。
# 若改用云供应商，不要把真实Key提交到Git。
