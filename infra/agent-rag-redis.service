[Unit]
Description=Agent RAG Lite Redis on port 26379
Documentation=https://redis.io/docs/
After=network.target

[Service]
Type=notify
ExecStart=/usr/bin/redis-server /etc/redis/agent-rag-lite.conf --supervised systemd
User=redis
Group=redis
RuntimeDirectory=redis-agent-rag-lite
RuntimeDirectoryMode=0750
StateDirectory=redis-agent-rag-lite
StateDirectoryMode=0750
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
